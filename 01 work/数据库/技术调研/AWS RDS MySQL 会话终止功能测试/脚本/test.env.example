# Path to a chmod 600 MySQL option file based on config.example.cnf.
CSK_ADMIN_CNF=/absolute/path/to/aws-rds-test.cnf

# The endpoint and port are repeated here only for disposable test-user
# connections. Do not put the master password in this file.
CSK_ENDPOINT=replace-with-rds-endpoint
CSK_PORT=3306

# Use only letters, digits, and underscore. Keep it short enough for MySQL
# account names. A unique prefix allows cleanup to target only test objects.
CSK_PREFIX=cskaws

# Optional. If empty, run.sh generates a random password for disposable users.
# CSK_TEST_PASSWORD=

# Query duration and target-discovery timeout in seconds.
CSK_SLEEP_SECONDS=30
CSK_DISCOVERY_SECONDS=10

# 0 cleans up users/database after the run; 1 leaves them for manual follow-up.
# The deep-semantics probe defaults to 1 when this setting is omitted.
CSK_KEEP_OBJECTS=0

# Grant-scope probe only. Global and mysql.* privileges are always revoked.
# Set to 1 only to retain the final rds_kill_query procedure-level chain.
CSK_KEEP_FINAL_PROCEDURE_CHAIN=0

